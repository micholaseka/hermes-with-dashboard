# Hermes webhook + CS Telegram bot configuration

# Secret untuk autentikasi webhook dari BotWatcher-Dashboard
HERMES_WEBHOOK_SECRET=your_webhook_secret_here

# Binding server (opsional)
HERMES_HOST=127.0.0.1
PORT=8765

# Telegram CS Bot (terpisah dari Hermes Agent)
TELEGRAM_CS_BOT_TOKEN=your_cs_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Secret untuk webhook Telegram (opsional)
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Engine mode: dev | chrome-portable
ENGINE_MODE=dev

# Direktori data Electron/BotWatcher (opsional, otomatis deteksi OS)
BOTWATCHER_DATA_DIR=/home/masterhand/.config/Electron

# Path kustom (opsional, untuk deploy ke Windows atau folder lain)
HERMES_PROJECT_ROOT=
HERMES_STORAGE_DIR=
HERMES_VAULT_ROOT=
